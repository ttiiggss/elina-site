---
import type { Feed } from '../data/socials';
import Icon from './Icon.astro';

export interface Props {
  feed: Feed;
}
const { feed } = Astro.props;
const posts = (feed.posts ?? []).filter(Boolean).slice(0, 3);
const isIg = feed.embed === 'instagram';
const isTk = feed.embed === 'tiktok';
const iconClass = isIg ? 'is-ig' : isTk ? 'is-tiktok' : '';
const iconStyle = iconClass ? '' : `--fi:${feed.accent}`;

function tiktokId(url: string): string {
  const m = url.match(/\/video\/(\d+)/);
  return m ? m[1] : '';
}
---

{
  posts.length === 0 ? (
    <div class="fallback-card" style={`--accent:${feed.accent}`}>
      <div class={`fb-icon ${iconClass}`} style={iconStyle}>
        <Icon name={feed.icon} size={28} />
      </div>
      <div class="fb-handle">{feed.handle}</div>
      <div class="fb-text">
        Add the latest {feed.platform} post URLs in <code>src/data/socials.ts</code> to embed them here.
      </div>
      <a class="fb-btn" href={feed.url} target="_blank" rel="noopener" style={`--accent:${feed.accent}`}>
        Open profile <Icon name="external" size={14} />
      </a>
    </div>
  ) : (
    <div class="embed-stack">
      {posts.map((url) => (
        <div class={`embed-item ${isIg ? 'instagram' : 'tiktok'}`}>
          {isIg ? (
            <blockquote
              class="instagram-media"
              data-instgrm-permalink={url}
              data-instgrm-version="14"
              style="background:#fff;border:0;margin:1px;max-width:540px;min-width:280px;padding:0;width:99.375%;border-radius:8px;overflow:hidden">
              <a
                href={url}
                target="_blank"
                rel="noopener"
                style="display:block;padding:12px;color:#c9c8cc;font-family:Arial,sans-serif;font-size:14px;font-weight:normal;line-height:17px;text-decoration:none;text-align:center">
                View this post on Instagram
              </a>
            </blockquote>
          ) : (
            <blockquote
              class="tiktok-embed"
              cite={url}
              data-video-id={tiktokId(url)}
              style="max-width:560px;min-width:288px;width:100%">
              <a href={url} target="_blank" rel="noopener">
                Watch on TikTok
              </a>
            </blockquote>
          )}
        </div>
      ))}
    </div>
  )
}

---
import type { Feed } from '../data/socials';

export interface Props {
  feed: Feed;
}
const { feed } = Astro.props;
---

<div class="twitch-wrap" data-twitch={feed.handle}>
  <div class="twitch-fallback">
    <svg class="big" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M11.64 5.93H13.07V10.21H11.64M15.57 5.93H17V10.21H15.57M7 2L3.43 5.57V18.43H7.71V22L11.29 18.43H14.14L20.57 12V2M19.14 11.29L16.29 14.14H13.43L10.93 16.64V14.14H7.71V3.43H19.14Z"></path>
    </svg>
    <strong>Loading channel&hellip;</strong>
    <a
      href={feed.url}
      target="_blank"
      rel="noopener"
      style="display:inline-flex;align-items:center;gap:.4em;margin-top:.6em;padding:.5em 1em;border-radius:999px;font-size:.85rem;font-weight:600;color:#fff;background:#9146ff;text-decoration:none;">
      Watch on Twitch &rarr;
    </a>
  </div>
</div>
<p class="twitch-note">Twitch has no &ldquo;posts&rdquo; &mdash; showing the live channel player instead.</p>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-twitch]').forEach(function (wrap) {
      var channel = wrap.getAttribute('data-twitch');
      var host = location.hostname || 'localhost';
      var src =
        'https://player.twitch.tv/?channel=' +
        encodeURIComponent(channel) +
        '&parent=' +
        encodeURIComponent(host) +
        '&muted=true&autoplay=false';
      var ifr = document.createElement('iframe');
      ifr.src = src;
      ifr.title = 'Twitch channel ' + channel;
      ifr.allowFullscreen = true;
      ifr.setAttribute('allow', 'fullscreen; autoplay');
      ifr.onload = function () {
        var fb = wrap.querySelector('.twitch-fallback');
        if (fb) fb.style.display = 'none';
      };
      wrap.appendChild(ifr);
    });
  })();
</script>

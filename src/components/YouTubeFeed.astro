---
// Renders 3 skeleton cards; a bundled script swaps them for the latest
// 3 uploads fetched live from /api/youtube (which proxies YouTube's RSS).
---
<div class="yt-list" data-yt-feed>
  <div class="sk-card">
    <div class="sk-thumb"></div>
    <div class="sk-lines"><div class="sk-line w-80"></div><div class="sk-line w-50"></div></div>
  </div>
  <div class="sk-card">
    <div class="sk-thumb"></div>
    <div class="sk-lines"><div class="sk-line w-80"></div><div class="sk-line w-50"></div></div>
  </div>
  <div class="sk-card">
    <div class="sk-thumb"></div>
    <div class="sk-lines"><div class="sk-line w-80"></div><div class="sk-line w-50"></div></div>
  </div>
</div>

<script>
  function relTime(iso: string): string {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    let s = Math.max(1, (Date.now() - d.getTime()) / 1000);
    const units: [number, string][] = [
      [60, 'second'],
      [60, 'minute'],
      [24, 'hour'],
      [7, 'day'],
      [4.345, 'week'],
      [12, 'month'],
      [Infinity, 'year'],
    ];
    let unit = 'second';
    for (const [div, name] of units) {
      if (s < div) {
        unit = name;
        break;
      }
      s /= div;
      unit = name;
    }
    const r = Math.floor(s);
    return `${r} ${unit}${r === 1 ? '' : 's'} ago`;
  }

  function fmtViews(v?: string): string {
    if (!v) return '';
    const n = parseInt(v.replace(/[^\d]/g, ''), 10);
    if (isNaN(n)) return v;
    if (n >= 1e6) return (n / 1e6).toFixed(1).replace('.0', '') + 'M views';
    if (n >= 1e3) return (n / 1e3).toFixed(1).replace('.0', '') + 'K views';
    return n + ' views';
  }

  async function loadYt(el: HTMLElement) {
    try {
      const res = await fetch('/api/youtube');
      if (!res.ok) throw new Error('http ' + res.status);
      const vids: { title: string; link: string; thumbnail: string; published: string; views?: string }[] =
        await res.json();
      if (!vids.length) throw new Error('empty');
      el.innerHTML = vids
        .map(
          (v) => `
        <a class="yt-card" href="${v.link}" target="_blank" rel="noopener">
          <div class="yt-thumb">
            <img src="${v.thumbnail}" alt="" loading="lazy" />
            <div class="yt-play"><span><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span></div>
          </div>
          <div class="yt-info">
            <div class="yt-title">${v.title}</div>
            <div class="yt-meta"><span title="${v.published}">${relTime(v.published)}</span>${v.views ? ' &middot; ' + fmtViews(v.views) : ''}</div>
          </div>
        </a>`,
        )
        .join('');
    } catch (e) {
      el.innerHTML = `
        <div class="yt-empty">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6M1 20v-6h6M3.5 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.65 4.36A9 9 0 0 0 20.5 15"/></svg>
          <span>Latest videos unavailable right now.</span>
        </div>`;
    }
  }

  document.querySelectorAll('[data-yt-feed]').forEach((el) => loadYt(el as HTMLElement));
</script>

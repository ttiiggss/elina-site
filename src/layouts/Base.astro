---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { feeds } from '../data/socials';

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Elina — Links & Latest Posts',
  description =
    "Elina's socials: the latest from Twitch, YouTube, Twitter, Instagram and TikTok, plus Discord, Throne and donations.",
} = Astro.props;

// Only pull in a platform's embed script when it's actually in use.
const hasTwitter = feeds.some((f) => f.kind === 'twitter');
const hasInstagram = feeds.some(
  (f) => f.embed === 'instagram' && (f.posts?.length ?? 0) > 0,
);
const hasTikTok = feeds.some(
  (f) => f.embed === 'tiktok' && (f.posts?.length ?? 0) > 0,
);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:image" content="/avatar.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // No-flash theme boot — runs before paint.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var stored = localStorage.getItem('elina-theme');
          var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          var theme = stored || (prefersLight ? 'light' : 'dark');
          root.setAttribute('data-theme', theme);
        } catch (e) {
          root.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <div class="bg-layer" aria-hidden="true">
      <div class="bg-mesh"></div>
      <div class="bg-grid"></div>
    </div>

    <header class="site-header">
      <a class="brand" href="/" aria-label="Elina — home">
        <img class="brand-mark" src="/favicon.svg" alt="" width="30" height="30" />
        <span>Elina<small>socials &amp; posts</small></span>
      </a>
      <div class="header-actions">
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">
          <Icon name="moon" size={16} class="icon-moon" />
          <Icon name="sun" size={16} class="icon-sun" />
          <span class="t-label">Theme</span>
        </button>
      </div>
    </header>

    <div class="shell">
      <main>
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <div class="container">
        <p>Made with <span class="heart">&hearts;</span> for Elina &mdash; posts pulled live from each platform.</p>
        <p style="margin-top:0.4em;">A polished tribute rebuild, not the official elina.chat.</p>
      </div>
    </footer>

    {hasTwitter && (
      <script is:inline>
        document.querySelectorAll('.twitter-timeline').forEach(function (a) {
          a.setAttribute('data-theme', document.documentElement.getAttribute('data-theme') || 'dark');
        });
      </script>
    )}
    {hasTwitter && (
      <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
    )}
    {hasInstagram && (
      <script is:inline async src="https://www.instagram.com/embed.js"></script>
    )}
    {hasTikTok && (
      <script is:inline async src="https://www.tiktok.com/embed.js"></script>
    )}

    <script>
      // Theme toggle
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('elina-theme', next);
        } catch (e) {}
        document
          .querySelectorAll('.twitter-timeline')
          .forEach((a) => a.setAttribute('data-theme', next));
        const twttr = (window as any).twttr;
        if (twttr?.widgets?.load) twttr.widgets.load();
      });

      // Hover-glow pointer tracking for action buttons
      document.querySelectorAll('.action-btn').forEach((el) => {
        el.addEventListener('mousemove', (e) => {
          const r = (el as HTMLElement).getBoundingClientRect();
          el.style.setProperty('--mx', `${(e as MouseEvent).clientX - r.left}px`);
          el.style.setProperty('--my', `${(e as MouseEvent).clientY - r.top}px`);
        });
      });

      // Scroll reveal
      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && reveals.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
        );
        reveals.forEach((r) => io.observe(r));
      } else {
        reveals.forEach((r) => r.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
